{
  "name": "pi-figma-kit",
  "version": "0.2.0",
  "description": "Pi extension: 33 Figma tools (design context, HTML/React/Tailwind/Compose codegen, screenshots, assets, design tokens, prototype flows, comments) and a /figma project browser, over the Figma REST API, with an optional bridge to the Figma desktop MCP server (live selection, Code Connect).",
  "keywords": [
    "pi-package",
    "pi-extension",
    "figma",
    "design",
    "design-tokens",
    "codegen",
    "compose",
    "tailwind",
    "mcp"
  ],
  "license": "MIT",
  "author": "sorinirimies",
  "files": [
    "extensions",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./extensions/figma.ts"
    ]
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "audit": "bun audit",
    "check": "nu scripts/ci/quality_gate.nu",
    "fuzz": "FUZZ_ITERS=20000 bun test tests/fuzz.test.ts --config=bunfig.fuzz.toml"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sorinirimies/pi-figma-kit.git"
  },
  "homepage": "https://github.com/sorinirimies/pi-figma-kit#readme"
}
